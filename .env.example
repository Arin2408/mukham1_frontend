# Copy to .env.local and fill in. Never commit .env.local.

# The FastAPI backend, including /api/v1/
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8002/api/v1/

# AWS Face Liveness in the browser (Cognito guest credentials)
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_IDENTITY_POOL_ID=

# The public web address, no trailing slash (canonical links, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
